TELEGRAM_BOT_TOKEN=your_bot_token_here
MONGODB_URI=your_mongodb_uri_here
OWNER_ID=your_telegram_user_id
LOG_GROUP_ID=0
SUPPORT_CHANNEL=https://t.me/TG_BIO_STYLE
BOT_USERNAME=JULIET_MUSUCBOT

# Gemini — https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-latest:generateContent
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODELS=gemini-flash-latest,gemini-2.5-flash,gemini-2.0-flash
GEMINI_IMAGE_MODELS=gemini-2.5-flash-image,gemini-2.0-flash-preview-image-generation

# Primary fallback — https://router.bynara.id
NARA_API_KEY=sk-nry-xxxx
NARA_BASE_URL=https://router.bynara.id/v1
NARA_MODELS=agnes-2.5-flash,agnes-2.0-flash,glm-5.3-flash-free,minimax-m3-free,laguna-s-2.1,auto/bynara,gpt-5.5
NARA_IMAGE_MODELS=agnes-image-2.1-flash,agnes-image-2.0-flash

# Backup
OPENROUTER_API_KEY=sk-or-xxxx
OPENROUTER_MODELS=openrouter/free,meta-llama/llama-3.3-70b-instruct:free,minimax/minimax-m3:free
OPENROUTER_IMAGE_MODELS=black-forest-labs/flux.2-schnell,google/gemini-2.5-flash-image

# free | balanced | high
AI_QUALITY=balanced
AI_MAX_TOKENS=180
AI_TEMPERATURE=0.85
