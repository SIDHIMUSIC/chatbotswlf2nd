{
  "name": "HARRY CHATBOT",
  "description": "Modular Telegram AI chatbot — NaraRouter + OpenRouter backup",
  "repository": "https://github.com/SIDHIMUSIC/chatbotswlf2nd",
  "logo": "https://graph.org/file/705cda02e63f4cb0bdb90-ce4d0ddd3a8cf38b5a.jpg",
  "keywords": ["telegram", "bot", "ai", "chatbot", "python"],
  "env": {
    "TELEGRAM_BOT_TOKEN": {
      "description": "Telegram Bot Token from @BotFather",
      "required": true
    },
    "MONGODB_URI": {
      "description": "MongoDB Connection URI",
      "required": true
    },
    "OWNER_ID": {
      "description": "Owner Telegram User ID",
      "required": true
    },
    "NARA_API_KEY": {
      "description": "NaraRouter API key from router.bynara.id",
      "required": false
    },
    "NARA_BASE_URL": {
      "description": "NaraRouter base URL",
      "required": false,
      "value": "https://router.bynara.id/v1"
    },
    "OPENROUTER_API_KEY": {
      "description": "OpenRouter backup API key",
      "required": false
    },
    "AI_QUALITY": {
      "description": "free | balanced | high",
      "required": false,
      "value": "balanced"
    },
    "AI_MAX_TOKENS": {
      "description": "Max reply tokens",
      "required": false,
      "value": "180"
    },
    "LOG_GROUP_ID": {
      "description": "Log Group ID (optional)",
      "required": false
    },
    "SUPPORT_CHANNEL": {
      "description": "Support Channel URL",
      "required": false,
      "value": "https://t.me/TG_BIO_STYLE"
    }
  },
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "eco"
    }
  },
  "buildpacks": [
    {
      "url": "heroku/python"
    }
  ]
}
